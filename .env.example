# ─── Server ────────────────────────────────────────────────────────────────────
PORT=3888
APP_BASE_URL=http://localhost:3888

# ─── Roon extension ────────────────────────────────────────────────────────────
ROON_EXTENSION_ID=com.textfromtrack.roon.companion
ROON_DISPLAY_NAME=TextFromTrack Roon Companion
ROON_DISPLAY_VERSION=0.1.0
ROON_PUBLISHER=TextFromTrack

# Direct Roon Core IP — skip Sood auto-discovery and connect via WebSocket.
# Required in Docker on macOS/Windows (Docker Desktop) where UDP multicast
# doesn't cross the NAT. Set to the LAN IP of the machine running Roon Core.
# ROON_CORE_HOST=192.168.1.x

# ─── Local music library ───────────────────────────────────────────────────────
# Comma-separated absolute paths to scan
MUSIC_ROOTS=/Users/yourname/Music,/Volumes/Music

# Path mappings — useful when Roon sees SMB paths the local app sees differently
# Format: <from>=<to>,<from>=<to>
# Example:
#   PATH_MAPPINGS=smb://DXP4800PLUS-RING.local/Music=/Volumes/Music,/volume2/music=/Volumes/Music
PATH_MAPPINGS=

# ─── TextFromTrack API ─────────────────────────────────────────────────────────
TFT_BASE_URL=https://app.textfromtrack.com/api/v1
# Create your PAT at https://app.textfromtrack.com/account/tokens
TFT_TOKEN=

# Export format for downloaded lyrics (lrc | srt | txt | json)
TFT_DEFAULT_EXPORT_FORMAT=lrc
TFT_DEFAULT_PINYIN=false
TFT_DEFAULT_VINTAGE=false

# ─── Polling ───────────────────────────────────────────────────────────────────
TFT_POLL_INTERVAL_MS=2000
TFT_POLL_TIMEOUT_MS=600000

# ─── Logging ───────────────────────────────────────────────────────────────────
# Levels: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
